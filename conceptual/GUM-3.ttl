@prefix : <http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix GUM-3: <http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@base <http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#> .

<http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl> rdf:type owl:Ontology ;
                                                                rdfs:comment """The Generalized Upper Model 3.0 (GUM 3.0) is a linguistically motivated ontology,
which aims primarily to mediate between natural language and application components.
It is based on the semantic perspective of natural language as described in Halliday
and Matthiessen [1999]. Therefore the concepts of the GUM ontology are influenced
strongly by the lexicogrammar of natural language and they are applicable in arbitrary
domains. The complete model and all of its concepts and principles are described
in detail in Bateman et al. [2006a], its underlying experimental linguistic results and
language analysis are documented in Bateman et al. [2006b]. Currently, the Generalized
Upper Model 3.0 is represented in OWL DL."""@en ,
                                                                             """developers: University of Bremen, SFB/TR8 Spatial Cognition, I1-[OntoSpace]
http://www.ontospace.uni-bremen.de""" ;
                                                                rdfs:label "GUM 3" ;
                                                                owl:versionInfo "3.1" ,
                                                                                "lisence: http://creativecommons.org/licenses/by-nc-nd/3.0/" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#accompaniment
GUM-3:accompaniment rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                    rdfs:range GUM-3:SimpleThing ;
                    rdfs:comment "This relation holds between objects which participate jointly in some process.  Accompaniment may be expressed as: {independent-argument} `be with' {dependent-argument}; or by a prepositional phrase beginning with the preposition `with' as in: {independent-	argument} ... `with' {dependent-argument}. Note that it is not necessary for both of the participants to be aware of the participation. Thus both of the following sentences are examples of this relation: (1) John went for a walk with Mary. (2) John went for a walk with his umbrella. The relation also allows for variation in both a positive and negative direction. For example, `without' is also a type of accompaniment, albeit negative, as is `instead of', which is an accompaniment of alternative." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#actee
GUM-3:actee rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf GUM-3:participantInConfiguration ;
            rdfs:range GUM-3:Element ;
            rdfs:comment "A process participant describing the entity to which a process is `done', `carried out on', etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#actor
GUM-3:actor rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf GUM-3:participantInConfiguration ;
            rdfs:comment "A transitivity function in a material clause; the participant always inherent in the clause according to the transitive model of transitivity. The process it participates in may or may not extend to affect another participant, the Goal. For instance, (Actor:) Henry (Process:) dove; (Actor:) Henry (Process:) kicked (Goal:) the ugly duckling." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#additive
GUM-3:additive rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:accompaniment ;
               rdfs:comment "One type of accompaniment that may holds between objects which participate jointly in some process. This form of accompaniment states that the accompaniment is positive and actual; it may be expressed by a prepositional phrase beginning with the preposition `as well as' as in: {independent-argument} ... `as well as' {dependent-argument}. The following sentences is an example of this relation: John went for a walk with Mary as well as Joan." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#addressee
GUM-3:addressee rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                rdfs:domain GUM-3:External ;
                rdfs:comment "Receiver of the communicative process, e.g. ``Henry told *me* that dinner would be ready at 6:00pm.'' This is called 'receiver' in Halliday and Matthiessen (1999: 130)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#agentive
GUM-3:agentive rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:generalizedMeans ,
                                  GUM-3:participantInConfiguration ;
               rdfs:range GUM-3:Element ;
               rdfs:comment "A type of participant and generalized-means that captures the notion of causal responsibility for a process' perfomance." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#alphaParticipantInMultiConfiguration
GUM-3:alphaParticipantInMultiConfiguration rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf GUM-3:participantInMultiConfiguration ;
                                           rdfs:domain GUM-3:GUMThing ;
                                           rdfs:range GUM-3:GUMThing ;
                                           rdfs:comment "For binary relations: this participant defines the starting point of the MultiConfiguration." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#alternative
GUM-3:alternative rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:accompaniment ;
                  rdfs:comment "One type of accompaniment that may holds between objects which participate jointly in some process. This form of accompaniment states that the accompaniment is positive but replacing; i.e., that some object participated in a process or state as an alternative to some other. It may be expressed as a prepositional phrase beginning with the preposition `instead'. as in: {independent-argument} ... `with' {dependent-argument}. Note that it is not necessary for both of the participants to be aware of the participation. Thus both of the following sentences are examples of this relation: (1) John went for a walk with Joan instead of Mary. (2) John went for a walk with his blue shoes instead of his white ones." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#anterior
GUM-3:anterior rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:temporalOrdering ;
               rdfs:comment "A relation between intervals that specifies their order in time. A type of temporal locating, a spatio-temporal circumstantial. Here one interval is said to be prior to	another." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#attribuend
GUM-3:attribuend rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                 rdfs:comment "The participant in a scaled comparison whose possession of a quality is being compared." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#attribute
GUM-3:attribute rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                rdfs:comment "The role played by the value in a Relating (HM 1999: 151)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#beneficiary
GUM-3:beneficiary rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                  rdfs:comment "A transitivity function in the clause, according to the generalized ergative transitivity model: the participant benefitting from the actualization of the combination of Process+Medium. In a material clause, it is the Recipient (My aunt gave *the farmer* a duckpress) or the Client (Pour *me* out a cold Dos Equis beer) and in a verbal one, it is the addressee (Joe told *us* all about Eve). It also occurs in a few relational clause types (I owe *you* an apology) and mental clauses (I envy *you* your luck; I don't begrudge *you* your happiness)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#betaParticipantInMultiConfiguration
GUM-3:betaParticipantInMultiConfiguration rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf GUM-3:participantInMultiConfiguration ;
                                          rdfs:domain GUM-3:GUMThing ;
                                          rdfs:range GUM-3:GUMThing ;
                                          rdfs:comment "For binary relations: this participant is dependent on the first participant of the MultiConfiguration. It usually extends the first participant." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#carrier
GUM-3:carrier rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf GUM-3:domain ;
              rdfs:range GUM-3:SimpleThing ;
              rdfs:comment "The role played by the thing that has attributes or is identified in Relatings (HM 1999: 183)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#causalRelation
GUM-3:causalRelation rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                     rdfs:comment "Causal-relation logically has two roles: cause (the domain) and effect (the range). At this most general level, causality may be expressed as: {effect} `because' {cause}, or {cause} `cause' {effect}." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#causeEffect
GUM-3:causeEffect rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:causalRelation ;
                  rdfs:comment "This captures the relationship of one thing being the cause of another, the effect." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#circumstanceInConfiguration
GUM-3:circumstanceInConfiguration rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf GUM-3:gumrelation ;
                                  rdfs:domain GUM-3:GUMThing ;
                                  rdfs:range GUM-3:Element ;
                                  rdfs:comment "This relates a Configuration to a Circumstance." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#client
GUM-3:client rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:beneficiary ,
                                GUM-3:causalRelation ;
             rdfs:range GUM-3:Element ;
             rdfs:comment "The role of beneficiary where something is done for another person." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#compareQuality
GUM-3:compareQuality rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                     rdfs:comment "The slot in a scaled comparison that contains that quality with respect to which an object (the attribuend) is being compared." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#comparison
GUM-3:comparison rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                 rdfs:comment "This category encompasses relations which indicate how similar or dissimilar two entities are. One subcategory is so-far discriminated: SIMILARITY. Difference could be presented as a further subtype, and equality could be a further specialization of similarity. Verbs articulated by this category include: `resemble', `differ from', `be similar to', `be different than', `be like', `match', `fit', etc. A grammatical characteristic of entities in this category is that they are symmetric, i.e. subject and object can be interchanged without passivization. Note however, that the passive form is still possible. For example, `` Henry resembles Joan. Joan resembles Henry. Joan is resembled by Henry.''" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#concessive
GUM-3:concessive rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:causalRelation ;
                 rdfs:comment "One type of generalized causation relationship. This relation states that some process occured despite some other event or state of affairs holding. It is typically realized in English by the preposition `despite' therefore." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#concurrent
GUM-3:concurrent rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:temporalOrdering ;
                 rdfs:comment "Concurrent temporal intervals overlap or occupy the same moments of time (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#condition
GUM-3:condition rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:reason ;
                rdfs:comment "A conditional relation describing a more general reason relation, e.g. \"if...then\"." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#configurationStage
GUM-3:configurationStage rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf GUM-3:gumrelation ;
                         rdfs:domain GUM-3:Configuration ;
                         rdfs:range GUM-3:ConfigurationStaging ;
                         rdfs:comment "That which holds between a Configuration and that Configuration's staging in terms of beginnings, endings, etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#configurationTemporality
GUM-3:configurationTemporality rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf GUM-3:gumrelation ;
                               rdfs:domain GUM-3:Configuration ;
                               rdfs:range GUM-3:TemporalProfile ;
                               rdfs:comment "That which holds between a Configuration and that Configuration's temporal profile." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#difference
GUM-3:difference rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:comparison ;
                 rdfs:comment "A sub-type of the comparison relationship that picks out negative comparison." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#domain
GUM-3:domain rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:participantInConfiguration ;
             rdfs:comment "One of the required relations in a Relating. Necessary for generation, but could be deleted later if the generator is changed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#enablement
GUM-3:enablement rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:generalizedMeans ;
                 rdfs:comment "A type of generalized means; this relation refers to a possible enabling relationship between the actualization of some process or state of affairs and an entity, state of affairs, or other process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#exclusive
GUM-3:exclusive rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:accompaniment ;
                rdfs:comment "A subtype of accompaniment that picks out the negative nature of accompaniment; an exclusive accompaniment indicates that accompaniment occured at the expense of, or instead of some entity that did not accompany." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#exhaustiveDuration
GUM-3:exhaustiveDuration rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf GUM-3:qualitativeTemporalExtent ;
                         rdfs:comment "An exhaustive duration is a relation which specifies that the process or state participating in the relation is one which holds for the entire extent of the	temporal interval participating in the relation. It is typically realized in English by the preposition `during'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#existent
GUM-3:existent rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:participantInConfiguration ;
               rdfs:domain GUM-3:Existence ;
               rdfs:comment "This relation defines the only participant allowed in an Existential Configuration." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#extremal
GUM-3:extremal rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:temporalOrdering ;
               rdfs:comment "A relation of temporal locating that explicitly orients to the end point of an interval; this establishes contrasts such as `until' (extremal) vs. `before' (nonextremal), and	`since' (extremal) vs. `after' (nonextremal)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#follow
GUM-3:follow rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:nonExtremal ;
             rdfs:comment "A temporal relationship of strict precedence; it is therefore posterior and nonextremal. It is an inverse to the precede relation that is used in tense reasoning by the grammar." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#generalizedMeans
GUM-3:generalizedMeans rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                       rdfs:comment "A type of participant which can be agentive, manner, instrumental, or enablemenet.	It is a generalized notion that refers to the abstract concept of the means for	actualizing some process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#greater
GUM-3:greater rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf GUM-3:attribuend ;
              rdfs:comment "A direction of comparison in a scaled comparison: here, the quality with respect to which comparison proceeds holds more rather than less." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#gumrelation
GUM-3:gumrelation rdf:type owl:ObjectProperty ;
                  rdfs:domain GUM-3:GUMThing ;
                  rdfs:range GUM-3:GUMThing ;
                  rdfs:comment "The most general property a concept can have." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#hasConjunct
GUM-3:hasConjunct rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:gumrelation ;
                  rdfs:comment "The binary relation between a Conjunction and one of its conjuncts." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#hasDisjunct
GUM-3:hasDisjunct rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:gumrelation ;
                  rdfs:comment "The binary relation between a Disjunction and one of its disjuncts." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#hasElaboration
GUM-3:hasElaboration rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf GUM-3:hasModification ;
                     rdfs:comment "An elaboration of an element. Ex.: \"A cheerful Mexican kitchen\" (HM06: p183)" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#hasEnhancement
GUM-3:hasEnhancement rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf GUM-3:hasModification ;
                     rdfs:comment "An enhancement of an element. Ex.: \"This 18th century vase from Mexico\" (HM06: p183)" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#hasExtension
GUM-3:hasExtension rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf GUM-3:hasModification ;
                   rdfs:comment "An extension of an element. Ex.: \"My aunt's teapot\" (HM06: p183)" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#hasModification
GUM-3:hasModification rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf GUM-3:gumrelation ;
                      rdfs:domain GUM-3:Element ;
                      rdfs:comment "A modification of a participant in a configuration. This relation adds attributes to an element. It can be linguistically expressed as epithets, classifiers, qualifiers, etc. (HM06: p183)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#inclusive
GUM-3:inclusive rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:accompaniment ;
                rdfs:comment "A subtype of accompaniment that picks out the positive nature of accompaniment; an exclusive accompaniment indicates that accompaniment occured in addition to	some other entity that accompanies." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#instrumental
GUM-3:instrumental rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf GUM-3:generalizedMeans ;
                   rdfs:comment "Instrument is typically expressed as: `{verb} + with' where {verb} cannot be `be'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#lesser
GUM-3:lesser rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:attribuend ;
             rdfs:comment "A direction of comparison in a scaled comparison: here the quality with respect to which comparison proceeds holds less rather than more." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#manner
GUM-3:manner rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:generalizedMeans ;
             rdfs:comment "A circumstantial role of a process that describes the manner in which the process'	actualization is achieved. Commonly realized by adverbs in English, although there	are other possibilities also." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#material
GUM-3:material rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:participantInConfiguration ;
               rdfs:comment "A participant role that carries information about the material from which an entity is constructed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#metaMessage
GUM-3:metaMessage rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:saying ;
                  rdfs:comment "The type of information, e.g., a story or lecture, being communicated by a communicative process (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#nonExhaustiveDuration
GUM-3:nonExhaustiveDuration rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf GUM-3:qualitativeTemporalExtent ;
                            rdfs:comment "An nonexhaustive duration is a relation which specifies that the process or state	participating in the relation is one which does not hold for the entire extent of the temporal interval participating in the relation. It is typically realized in English by the preposition `in'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#nonExtremal
GUM-3:nonExtremal rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf GUM-3:temporalOrdering ;
                  rdfs:comment "A relationship of temporal locating that is not oriented to the end points of an interval; examples of this distinction are: `until' (extremal) vs. `before' (nonextremal), and `since' (extremal) vs. `after' (nonextremal)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#nonMetaMessage
GUM-3:nonMetaMessage rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf GUM-3:saying ;
                     rdfs:comment "The information being communicated by a communicative process (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#orderingRelation
GUM-3:orderingRelation rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                       rdfs:comment "The general relationship that holds between the parts of an ordered object." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#participantInConfiguration
GUM-3:participantInConfiguration rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf GUM-3:gumrelation ;
                                 rdfs:domain GUM-3:GUMThing ;
                                 rdfs:comment "A Configuration is said to `contain' some number of entities that participate in its actualization. The manner of these entities is identified in terms of given role names. Participants in a process typically come from the SimpleThing hierarchy and are realized as nominal groups. Clearly there are some kinds of relations which will have actions or processes as their participants, e.g. causality." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#participantInMultiConfiguration
GUM-3:participantInMultiConfiguration rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf GUM-3:gumrelation ;
                                      rdfs:domain GUM-3:MultiConfiguration ;
                                      rdfs:range [ rdf:type owl:Class ;
                                                   owl:unionOf ( GUM-3:Configuration
                                                                 GUM-3:MultiConfiguration
                                                               )
                                                 ] ;
                                      rdfs:comment "This property defines the participants of combinations of Configurations. For more complex structures participants can also be MultiConfigurations." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#phenomenon
GUM-3:phenomenon rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                 rdfs:domain GUM-3:Internal ;
                 rdfs:comment "The object of perception in an InternalProcessing (HM 1999: 131)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#possessed
GUM-3:possessed rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                rdfs:comment "This relation relates the configuration to an entity which has an owner (possessor)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#possessor
GUM-3:possessor rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:participantInConfiguration ;
                rdfs:comment "This relation relates the configuration to an entitiy which possesses something (possessed)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#posterior
GUM-3:posterior rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:temporalOrdering ;
                rdfs:comment "A relation between intervals that specifies their order in time. A type of temporal locating, a circumstantial (somewhere under relational process) with range of a time interval and a commented out domain of a process. Here one interval is said to follow another." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#posterior-extremal
GUM-3:posterior-extremal rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf GUM-3:extremal ,
                                            GUM-3:posterior ;
                         rdfs:comment "(from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#precede
GUM-3:precede rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf GUM-3:anterior ,
                                 GUM-3:nonExtremal ;
              rdfs:comment "A temporal relationship of strict precedence; it is therefore anterior and nonextremal. It is used particularly in tense reasoning by the grammar." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#processInConfiguration
GUM-3:processInConfiguration rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf GUM-3:gumrelation ;
                             rdfs:domain GUM-3:Configuration ;
                             rdfs:range GUM-3:Process ;
                             rdfs:comment "That which holds between a Configuration and a Process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#processRange
GUM-3:processRange rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf GUM-3:actee ;
                   rdfs:domain GUM-3:DoingAndHappening ;
                   rdfs:comment "A participant role where the participant is not affected or altered by the actualization of the process, but instead serves more to define the nature of the process, e.g. \"The car turned the corner.'' Here the corner is the range over which the process is occurring. The reason processRange is a subclass of actee is that the filler of processRange \"acts like\" an actee, i.e. comes after the verb without a preposition intervening. (Probably in conflict with grammar.)" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#prompt
GUM-3:prompt rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:participantInConfiguration ;
             rdfs:comment "The information process preceding the recent communicative process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#purpose
GUM-3:purpose rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf GUM-3:causalRelation ;
              rdfs:comment "Purpose captures the notion of why something was done. They may be motivational as with `reasons' but look forward rather than back." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#qualitativeTemporalExtent
GUM-3:qualitativeTemporalExtent rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf GUM-3:temporalExtent ;
                                rdfs:comment """A qualitative temporal extent, e.g., \"a long while\".
A relationship of temporal extent that is classified as qualitative. Qualitative here refers to a posited property of temporal relationships concerning how they are treated by the grammar of a language. Qualitative spatial relationships are taken to `move along with' an observer. This contrasts with absolute relationships which do not accompany the observer. As an example, the notion of `today', `tomorrow', etc. do not stand still and allow the observer to pass them by, they move with the observer; this is in contrast to the notion of a `Monday', which can come and pass the observer by.""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#quantitativeTemporalExtent
GUM-3:quantitativeTemporalExtent rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf GUM-3:temporalExtent ;
                                 rdfs:comment """A quantitative temporal extent, e.g., \"three hours\".
A relationship of temporal extent that is classified as quantitative. Quantitative here refers to a posited property of temporal relationships concerning how they are treated by the grammar of English. Absolute temporal relationships are taken to be unchanging with respect to the observer. A relative relationship is one that moves with the observer. As an example, the notion of `today', `tomorrow', etc. do not stand still and allow the observer to pass them by, they move with the observer; this is in contrast to the notion of a `Monday', which can come and pass the observer by.""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#range
GUM-3:range rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf GUM-3:participantInConfiguration ;
            rdfs:comment "One of the required relations in a Relating. Necessary for generation, but could be deleted later if the generator is changed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#reason
GUM-3:reason rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:causalRelation ;
             rdfs:comment "REASON captures the notion of motivation. Here the effect is volitional or intentional. This relation is expressed by terms such as: `since', `because'. Examples include: ``Henry went to the store because he needed milk.'' and ``since it was raining, Henry brought his umbrella.''" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#recipient
GUM-3:recipient rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf GUM-3:beneficiary ;
                rdfs:comment "The beneficiary participant role of a material process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#result
GUM-3:result rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:actee ;
             rdfs:comment "A particular type of participant relationship to a process: identifies the participant that is in the role of being affected, acted upon, or brought into being by the	actualization of the process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#sayer
GUM-3:sayer rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf GUM-3:participantInConfiguration ;
            rdfs:domain GUM-3:External ;
            rdfs:comment "The required role in an ExternalProcess; this requires a symbolic source, a concious or non-concious being (HM 1999: 130)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#saying
GUM-3:saying rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:participantInConfiguration ;
             rdfs:comment "The information being communicated by a communicative process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#senser
GUM-3:senser rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf GUM-3:participantInConfiguration ;
             rdfs:domain GUM-3:Internal ;
             rdfs:range GUM-3:ConsciousBeing ;
             rdfs:comment """The required role in an InternalProcess. The range is restricted to be a conscious-being (HM 1999: 130).
----unedited----
Examples include: `happy', `angry', `sad', `amused', `afraid'. Constructions involving qualities in this class can specify a fact as the cau--se of the mental state. For example, ``Henry was sad that he missed the performance''. ``Henry was angry because the train was late''. Note that such constructions are not possible with phenomenon-oriented-qualities. Some qualities fall into both categories, but are expressed differently depending on their classification. Compare: ``I am *amazed* that the earth is flat'' (senser-oriented); ``That the earth is flat is *amazing* to me'' (phenomenon-oriented). (Bateman, Henschel, and Rinaldi 1995: 64)""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#similarity
GUM-3:similarity rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf GUM-3:comparison ;
                 rdfs:comment "A sub-type of the comparison relationship that picks out positive comparison." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#since
GUM-3:since rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf GUM-3:posterior-extremal ;
            rdfs:comment "(from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#spatialCircumstance
GUM-3:spatialCircumstance rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf GUM-3:spatialTemporalCircumstance ;
                          rdfs:comment "This describes the relation of two entites in space." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#spatialTemporalCircumstance
GUM-3:spatialTemporalCircumstance rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                                  rdfs:comment "This relation represents all circumstantial spatial or temporal relations of any configuration." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#standard
GUM-3:standard rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf GUM-3:participantInConfiguration ;
               rdfs:comment "The standard against which comparison is drawn in a scaled comparison." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#subjectMatter
GUM-3:subjectMatter rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf GUM-3:circumstanceInConfiguration ;
                    rdfs:comment "Expressed as: be about, as in: ``This document is about the entity hierarchy.''" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalCircumstance
GUM-3:temporalCircumstance rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf GUM-3:spatialTemporalCircumstance ;
                           rdfs:comment "This describes the relation of two entites in time." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalExtent
GUM-3:temporalExtent rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf GUM-3:temporalCircumstance ;
                     rdfs:range GUM-3:TemporalObject ;
                     rdfs:comment "A temporal relation of specifying the time that a state of affairs or process holds (e.g. `for 5 years')." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalInclusive
GUM-3:temporalInclusive rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf GUM-3:concurrent ;
                        rdfs:comment "In a temporal inclusive relation, the first interval completely includes or covers the second (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalLocating
GUM-3:temporalLocating rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf GUM-3:temporalRelation ;
                       rdfs:comment "The relationship between an object or process and its location in time." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalNonOrdering
GUM-3:temporalNonOrdering rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf GUM-3:temporalLocating ;
                          rdfs:comment "A class of temporal relations that do not impose any ordering on the points or intervals they hold over. Examples of these would typically be realized in English by the prepositions `in', `at', `on', etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalOrdering
GUM-3:temporalOrdering rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf GUM-3:orderingRelation ,
                                          GUM-3:temporalLocating ;
                       rdfs:comment "The ordering relation that can hold between points or intervals in time." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#temporalRelation
GUM-3:temporalRelation rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf GUM-3:temporalCircumstance ;
                       rdfs:comment "TEMPORAL-RELATION is often expressed using `be at'. It may also be expressed as a prepositional phrase beginning with a preposition such as `before' or `after'. Further discriminations select between these possibilities." .


#################################################################
#    Classes
#################################################################

###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Ability
GUM-3:Ability rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Possibility ;
              owl:disjointWith GUM-3:GeneralPossibility ;
              rdfs:comment "A modal qualification of the process, with respect to the ability to perform that process; typically realized by `can'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Abstraction
GUM-3:Abstraction rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:NonConsciousThing ;
                  owl:disjointWith GUM-3:SpatialTemporal ,
                                   GUM-3:Substance ;
                  rdfs:comment "Something which exists in metaphorical or qualitative space rather than in physical space, e.g., truth." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AddresseeOriented
GUM-3:AddresseeOriented rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:ProperVerbal ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty GUM-3:addressee ;
                                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                                        ] ;
                        owl:disjointWith GUM-3:MessageOriented ,
                                         GUM-3:NonAddresseeOriented ;
                        rdfs:comment "AddresseeOriented defines a process for which the addressee is mandatory. However, in come cases the addressee may not be expressed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Addressing
GUM-3:Addressing rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:BehavioralVerbal ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty GUM-3:addressee ;
                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 owl:disjointWith GUM-3:NonAddressing ;
                 rdfs:comment "It is mandatory for this configuration to have an addressee as a direct object." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AddressingVerbal
GUM-3:AddressingVerbal rdf:type owl:Class ;
                       rdfs:subClassOf GUM-3:AddresseeOriented ,
                                       GUM-3:NonMessageOriented ;
                       owl:disjointWith GUM-3:CommunicativeAttitude ;
                       rdfs:comment "AddressingVerbal configurations are expressed by the use of verbs which take the addressee as a direct object." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AffectingAction
GUM-3:AffectingAction rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:DoingAndHappening ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty GUM-3:actee ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ;
                      owl:disjointWith GUM-3:NonAffectingAction ;
                      rdfs:comment "AffectingActions have an ACTEE role. They are always transitive, although they may be acteeintransitive. In this case, the actee is not specified, but is inferrable. For example, ``Henry hunts.'' In this case, we can infer that Henry hunts something in the category of `huntablethings'. AffectingActions can always have a beneficiary of the client type. This is expressed by the prepositional phrase: `for' client. Directed actions are further broken up into two subclasses depending upon whether or not the actee existed before the action occurred." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Age
GUM-3:Age rdf:type owl:Class ;
          rdfs:subClassOf GUM-3:SenseANDMeasureQuality ;
          owl:disjointWith GUM-3:Color ,
                           GUM-3:Size ;
          rdfs:comment "A sense and measure quality pertaining to the age of an entity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AgePropertyAscription
GUM-3:AgePropertyAscription rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:PropertyAscription ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty GUM-3:attribute ;
                                              owl:allValuesFrom GUM-3:Age
                                            ] ;
                            owl:disjointWith GUM-3:ColorPropertyAscription ,
                                             GUM-3:LogicalPropertyAscription ,
                                             GUM-3:MaterialPropertyAscription ,
                                             GUM-3:ModalPropertyAscription ,
                                             GUM-3:ProvenancePropertyAscription ,
                                             GUM-3:ScaledComparison ,
                                             GUM-3:SizePropertyAscription ,
                                             GUM-3:UsePropertyAscription ;
                            rdfs:comment "The type of ascription of property that ascribes a quality of age to an object." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Ambience
GUM-3:Ambience rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:NonAffectingAction ;
               owl:disjointWith GUM-3:NonAffectingDoing ,
                                GUM-3:NonAffectingHappening ;
               rdfs:comment "A process describing an ambient condition, such as the weather, temperature, etc. The term \"Meteorological Processes\" is also sometimes used." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Ascription
GUM-3:Ascription rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:Intensive ;
                 owl:disjointWith GUM-3:Identity ,
                                  GUM-3:Symbolization ;
                 rdfs:comment "This two place relation captures the notion of membership in a set. In general, the domain (attribuend) will be filled by an object. The range (attribute) will be filled by a quality or by an object. Finer restrictions can be made based on the given attribute. This relation is typically expressed by the verb `be'. The inverse is AscriptionInverse. Note that this relation does not claim to be exhaustive." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AscriptionInverse
GUM-3:AscriptionInverse rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:GeneralizedPossession ;
                        owl:disjointWith GUM-3:GeneralizedRoleRelation ,
                                         GUM-3:NameOf ,
                                         GUM-3:Ownership ,
                                         GUM-3:PartWhole ;
                        rdfs:comment "The inverse of the Ascription relation. ClassAscription offers an alternative to the subclass relation. For example, we may want to say \"John is a democrat\" without making John a subclass of Democrat." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AtLeast
GUM-3:AtLeast rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:NumberFocusing ;
              owl:disjointWith GUM-3:AtMost ,
                               GUM-3:Exactly ,
                               GUM-3:GreaterThan ,
                               GUM-3:LessThan ;
              rdfs:comment "An ascription of relative quantity that puts a lower bound on the quantity ascribed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#AtMost
GUM-3:AtMost rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:NumberFocusing ;
             owl:disjointWith GUM-3:Exactly ,
                              GUM-3:GreaterThan ,
                              GUM-3:LessThan ;
             rdfs:comment "An ascription of relative quantity that puts an upper bound on the quantity ascribed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#BehavioralQuality
GUM-3:BehavioralQuality rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:DynamicQuality ,
                                        GUM-3:PolarQuality ,
                                        GUM-3:ScalableQuality ;
                        owl:disjointWith GUM-3:EvaluativeQuality ,
                                         GUM-3:SenseANDMeasureQuality ,
                                         GUM-3:StatusQuality ;
                        rdfs:comment "Behavioral qualities are qualities which characterize the behavior of a conscious being." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#BehavioralVerbal
GUM-3:BehavioralVerbal rdf:type owl:Class ;
                       rdfs:subClassOf GUM-3:External ;
                       owl:disjointWith GUM-3:NameEvent ,
                                        GUM-3:ProperVerbal ;
                       rdfs:comment "This concept describes processes of configurations which fall in between classes of \"material and verbal processes\" (Bateman, Henschel, and Rinaldi 1995: 42). Including both, material processes that represent human behaviours (\"moan\", \"groan\", etc.) and which can be used like verbal processes (e.g. projection), and verbal processes (like \"John is talking about the President\") which do not share typical properties of verbal processes (e.g. projection)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#BeingAndHaving
GUM-3:BeingAndHaving rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:Configuration ;
                     owl:disjointWith GUM-3:DoingAndHappening ,
                                      GUM-3:SayingAndSensing ;
                     rdfs:comment "A Configuration that relates its participants rather than describing an action of one on another. In contrast to DoingANDHappening, not input of energy is required nor is it always the case that there will be change over time (HM 1999: 132)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Believe
GUM-3:Believe rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Cognition ;
              owl:disjointWith GUM-3:Know ,
                               GUM-3:Think ;
              rdfs:comment "The involuntary mental process of holding a belief." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Causal
GUM-3:Causal rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:Circumstantial ;
             owl:disjointWith GUM-3:CircumstantialOther ,
                              GUM-3:GeneralizedLocating ;
             rdfs:comment "This concept defines a Configuration, in which one of the participants is the cause of the other. Hence, one of the participants occupies the role \"cause\", and the other one \"effect\" (Bateman, Rinaldi, and Henschel 1995, p. 33)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Circumstance
GUM-3:Circumstance rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:Element ;
                   owl:disjointWith GUM-3:Process ,
                                    GUM-3:SimpleQuality ,
                                    GUM-3:SimpleThing ;
                   rdfs:comment "Circumstances are often realized as adverbial groups or prepositional phrases. The kinds of entities that can be used as circumstances (places, times, etc.) can also serve as participants in the appropriate configurations. Circumstances fill circumstantial roles in figures. Most circumstantial elements embody some feature of grammatical metaphor. Of those that do not, the most usual are those of time, place, manner, quality and intensity. Circumstances are realized as adverbial groups or prepositional phrases. Circumstances expressed as adverbial groups come from the CIRCUMSTANCE hierarchy, while those expressed as prepositional phrases are represented as circumstantial relations [HM99, p. ]." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Circumstantial
GUM-3:Circumstantial rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:Relating ;
                     owl:disjointWith GUM-3:GeneralizedPossession ,
                                      GUM-3:GeneralizedPossessionInverse ,
                                      GUM-3:Intensive ;
                     rdfs:comment "This class relates an entity to its cause, generalized location (in space, time, abstract space), or other circumstance-like entities (Bateman, Rinaldi, and Henschel 1995, p. 33)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#CircumstantialOther
GUM-3:CircumstantialOther rdf:type owl:Class ;
                          rdfs:subClassOf GUM-3:Circumstantial ;
                          owl:disjointWith GUM-3:GeneralizedLocating ;
                          rdfs:comment "This concepts captures all Circumstantial configurations which are not" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ClassAscription
GUM-3:ClassAscription rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:Ascription ;
                      owl:disjointWith GUM-3:LogicalQuality ,
                                       GUM-3:MaterialWorldQuality ,
                                       GUM-3:ModalQuality ;
                      rdfs:comment "For this two place relation, both the domain (functioning as `attribuend') and the range (functioning as `attribute') are restricted to be filled by objects. This relation corresponds to the SuperClass notion. It too is often expressed by the verb `be'. For example, ``Henry is a teacher.''" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ClassQuality
GUM-3:ClassQuality rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:NonScalableQuality ,
                                   GUM-3:StativeQuality ,
                                   GUM-3:TaxonomicQuality ;
                   owl:disjointWith GUM-3:EvaluativeQuality ,
                                    GUM-3:SenseANDMeasureQuality ,
                                    GUM-3:StatusQuality ;
                   rdfs:comment "This category may contain various taxonomies." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Cognition
GUM-3:Cognition rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:Internal ;
                owl:disjointWith GUM-3:Intention ,
                                 GUM-3:MentalActive ,
                                 GUM-3:MentalInactive ,
                                 GUM-3:Perception ,
                                 GUM-3:ReactionAndEmotion ;
                rdfs:comment "Processes of cognition realized by the verbs `think', `believe', `know', `understand', `realize'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Color
GUM-3:Color rdf:type owl:Class ;
            rdfs:subClassOf GUM-3:SenseANDMeasureQuality ;
            owl:disjointWith GUM-3:Size ;
            rdfs:comment "A sense and measure quality pertaining to color." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ColorPropertyAscription
GUM-3:ColorPropertyAscription rdf:type owl:Class ;
                              rdfs:subClassOf GUM-3:PropertyAscription ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty GUM-3:attribute ;
                                                owl:allValuesFrom GUM-3:Color
                                              ] ;
                              owl:disjointWith GUM-3:LogicalPropertyAscription ,
                                               GUM-3:MaterialPropertyAscription ,
                                               GUM-3:ModalPropertyAscription ,
                                               GUM-3:ProvenancePropertyAscription ,
                                               GUM-3:ScaledComparison ,
                                               GUM-3:SizePropertyAscription ,
                                               GUM-3:UsePropertyAscription ;
                              rdfs:comment "The type of ascription of property that ascribes a quality of color to an object." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#CommunicativeAttitude
GUM-3:CommunicativeAttitude rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:NonAddresseeOriented ,
                                            GUM-3:NonMessageOriented ;
                            owl:disjointWith GUM-3:MessageTransfer ;
                            rdfs:comment "CommunicativeAttitude verbal configurations are realized by means of a verb for which the addressee as well as the message cannot be expressed by a direct complement (e.g. \"complain\")." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Conditional
GUM-3:Conditional rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:ModalQuality ;
                  owl:disjointWith GUM-3:NonConditional ,
                                   GUM-3:NonVolitional ,
                                   GUM-3:Volitional ;
                  rdfs:comment "A type of modal quality. Modal qualities that are conditional are expressed by `would', `might', `could', etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Configuration
GUM-3:Configuration rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:GUMThing ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty GUM-3:configurationTemporality ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass GUM-3:TemporalProfile
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty GUM-3:processInConfiguration ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass GUM-3:Process
                                    ] ;
                    owl:disjointWith GUM-3:Element ,
                                     GUM-3:MultiConfiguration ;
                    rdfs:comment "A Configuration, or 'figure', is the basic fragment of experience that embodies one quantum of change (HM 1999: 128).  It is the totality of all the Elements participating in some activity or state of affairs (Bateman, Henschel, and Rinaldi 1995: 13). Configurations are expressed at the level of the clause and potentially consist of three components: the Process itself, Participants in the Process, and Circumstances associated with the Process. A Configuration must contain just one Process. It unfolds through time." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationBeginning
GUM-3:ConfigurationBeginning rdf:type owl:Class ;
                             rdfs:subClassOf GUM-3:ConfigurationBoundary ;
                             owl:disjointWith GUM-3:ConfigurationEnding ;
                             rdfs:comment "A Configuration may begin (HM 1999: 271)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationBoundary
GUM-3:ConfigurationBoundary rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:ConfigurationStaging ;
                            owl:disjointWith GUM-3:ConfigurationContinuity ;
                            rdfs:comment "A Configuration exhibits stages, typically temporal, such as beginning, continuing, ending (HM 1999: 216)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationContinuity
GUM-3:ConfigurationContinuity rdf:type owl:Class ;
                              rdfs:subClassOf GUM-3:ConfigurationStaging ;
                              rdfs:comment "A Configuration ehxibits stages, typically temporal, such as beginning, continuing, ending (HM 1999: 216)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationEnding
GUM-3:ConfigurationEnding rdf:type owl:Class ;
                          rdfs:subClassOf GUM-3:ConfigurationBoundary ;
                          rdfs:comment "A Configuration may come to an end (HM 1999: 271)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationInitializing
GUM-3:ConfigurationInitializing rdf:type owl:Class ;
                                rdfs:subClassOf GUM-3:ConfigurationBeginning ;
                                owl:disjointWith GUM-3:ConfigurationResuming ;
                                rdfs:comment "A Configuration may start (for the first time)  (HM 1999: 271)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationResuming
GUM-3:ConfigurationResuming rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:ConfigurationBeginning ;
                            rdfs:comment "A Configuration may start up again or resume (HM 1999: 271)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConfigurationStaging
GUM-3:ConfigurationStaging rdf:type owl:Class ;
                           rdfs:subClassOf GUM-3:ProfilesAndStages ;
                           owl:disjointWith GUM-3:TemporalProfile ;
                           rdfs:comment "A Configuration exhibits stages, typically temporal, such as beginning, continuing, ending (HM 1999: 216)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Conjunction
GUM-3:Conjunction rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Extension ;
                  owl:disjointWith GUM-3:Disjunction ;
                  rdfs:comment "A logical additive combination of two or more configurations; often realized by conjoining with `and', `also', `in addition', etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ConsciousBeing
GUM-3:ConsciousBeing rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:SimpleThing ;
                     owl:disjointWith GUM-3:NonConsciousThing ;
                     rdfs:comment "An active entity that is capable of producing information that may be ascribed consciousness; e.g. a person." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#CreativeMaterialAction
GUM-3:CreativeMaterialAction rdf:type owl:Class ;
                             rdfs:subClassOf GUM-3:AffectingAction ;
                             owl:disjointWith GUM-3:DispositiveMaterialAction ;
                             rdfs:comment "Actions in this category create their actee. For example, ``Mary baked a cake.'' All actions in this category can be realized using the verbs `create' or `make'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DecomposableObject
GUM-3:DecomposableObject rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:SimpleThing ;
                         owl:disjointWith GUM-3:NonDecomposableObject ;
                         rdfs:comment "An object that is being viewed as being made up of parts that may be taken apart and are often given explicit linguistic recognition." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DiffuseMatter
GUM-3:DiffuseMatter rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:SubjectMatter ;
                    owl:disjointWith GUM-3:SpecificMatter ;
                    rdfs:comment "Distinguish between explicit focus on referent, and more general, diffuse reference (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Disjunction
GUM-3:Disjunction rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Extension ;
                  rdfs:comment "A logical disjunctive combination of two or more configurations; often realized by conjoining with `or' or `alternatively'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DisjunctiveSet
GUM-3:DisjunctiveSet rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:UMSet ;
                     owl:disjointWith GUM-3:OrderedSet ;
                     rdfs:comment "A set of alternatives." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Disliking
GUM-3:Disliking rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:ReactionAndEmotion ;
                owl:disjointWith GUM-3:Fearing ,
                                 GUM-3:Liking ;
                rdfs:comment "A mental reaction that is negative towards some object or state of affairs." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DispositiveMaterialAction
GUM-3:DispositiveMaterialAction rdf:type owl:Class ;
                                rdfs:subClassOf GUM-3:AffectingAction ;
                                rdfs:comment "Actions in this category affect their actee. This category includes any verbs that describe an action on something that already exists, e.g. ``Eunice ate the cake.''" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DoingAndHappening
GUM-3:DoingAndHappening rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:Configuration ,
                                        [ rdf:type owl:Class ;
                                          owl:unionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty GUM-3:actor ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass GUM-3:Element
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty GUM-3:agentive ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass GUM-3:Element
                                                        ]
                                                      )
                                        ] ;
                        rdfs:comment """A Configuration that requires the input of energy usually from one of the participants. It also involves change over time, such as circumstantial change, qualitative change, or change in possession (HM 1999: 132).

DoingANDHappening includes both intentional actions, i.e. actions with a volitional actor, e.g. ``The mouse ran up the clock'' and happenings, such as Erosion and Disintegration, e.g. ``The wall came tumbling down.'' The role of this relation is: Actor. This should be value-restricted to simplethings excluding things created by mental processing (e.g. facts) and speech (direct or indirect). Material actions which are in the process of occurring are typically expressed in the present progressive tense. Compare the following: ``My watch says it is 4:30pm.'' vs. ``Henry is going to the market.'' Thus, a test for determining whether a concept falls into this category is to look at the natural way of expressing the concept. For example, ``The house collapses'' (nonprogressive) vs.  ``The house is collapsing'' (progressive).""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DurationInTime
GUM-3:DurationInTime rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:TemporalProfile ;
                     owl:disjointWith GUM-3:InstantaneousInTime ;
                     rdfs:comment "A Configuration may be take time to unfold or be instantaneous (HM 1999: 471). Duration applies to all kinds of configurations apart from instantaneous changes, as occur in resultatives when the end state is achieved (cf. Dowty, Frawley, Bach). " .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#DynamicQuality
GUM-3:DynamicQuality rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:MaterialWorldQuality ;
                     owl:disjointWith GUM-3:NonScalableQuality ,
                                      GUM-3:StativeQuality ,
                                      GUM-3:TaxonomicQuality ;
                     rdfs:comment "A quality can be stative or dynamic. A quality is dynamic if the entity possessing this quality must exert some effort in order to maintain the quality. Stative qualities hold regardless of any particular process. Dynamic qualities can be expressed using the present progressive tense, i.e. they can take the form: `X is being quality.' John is being clever/skillful/creative/enthusiastic. Stative qualities cannot take this form: *John is being dead/German/tall. These can take the simple present only." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Elaboration
GUM-3:Elaboration rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Expansion ;
                  owl:disjointWith GUM-3:Enhancement ,
                                   GUM-3:Extension ;
                  rdfs:comment "An expansion such that the two configurations offer different perspectives of the same thing. E.g., `it matters a lot; it plays an important role' (HM 1999: 117)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Element
GUM-3:Element rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:GUMThing ;
              owl:disjointWith GUM-3:MultiConfiguration ;
              rdfs:comment "An Element is a single 'stand-alone' object or conceptual item (Bateman, Henschel, and Rinaldi 1995, p. 13). They are expressed as constituents below the clause. Elements fill roles of Configurations." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ElementList
GUM-3:ElementList rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Part ;
                  rdfs:comment "A type of PartWhole relationship, such as that holding is between a list and its elements. It is the inverse of the ElementList relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ElementOf
GUM-3:ElementOf rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:PartOf ;
                rdfs:comment "The inverse of the Element relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Enhancement
GUM-3:Enhancement rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Expansion ;
                  owl:disjointWith GUM-3:Extension ;
                  rdfs:comment "An expansion such that configuration qualifies the other; e.g., `it is autumn, so the leaves are turning brown' (HM 1999: 117)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#EvaluativeQuality
GUM-3:EvaluativeQuality rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:PolarQuality ,
                                        GUM-3:ScalableQuality ,
                                        GUM-3:StativeQuality ;
                        owl:disjointWith GUM-3:SenseANDMeasureQuality ,
                                         GUM-3:StatusQuality ;
                        rdfs:comment "Qualities which belong to this class are determined by some value system of some conscious being. Such a value system may be moral, aesthetic, or utilitarian. Moral qualities include `honest', `polite', `generous'. `Beautiful', `neat' are examples of aesthetic qualities. `Readable', `easy', and `thorough' are some taskoriented qualities." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Exactly
GUM-3:Exactly rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:NumberFocusing ;
              owl:disjointWith GUM-3:GreaterThan ,
                               GUM-3:LessThan ;
              rdfs:comment "A relation of focusing or restricting an attribution of quantity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Existence
GUM-3:Existence rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:BeingAndHaving ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty GUM-3:existent ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass GUM-3:Element
                                ] ;
                owl:disjointWith GUM-3:Relating ;
                rdfs:comment "A one-place relation found, for example, in ``There is a block.'' Note that the notion of `state' does not come out as a category of special status in the upper model. Instead, what we may think of as state is spread out over several concepts, e.g. relations and  qualities. If considerations of inferencing require the notion of state, it will be necessary to recognize it as a separate category." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Expansion
GUM-3:Expansion rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:MultiConfiguration ;
                owl:disjointWith GUM-3:Projection ;
                rdfs:comment "A multiconfiguration of two configurations such that they both occupy the same order of reality, and such that one adds dimensionality to the other (HM 1999: 117)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Extension
GUM-3:Extension rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:Expansion ;
                rdfs:comment "An expansion such that the first configuration is additive to the other in terms of information value; e.g., `he is too young and he doesn't speak the language' (HM 1999: 117)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#External
GUM-3:External rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:SayingAndSensing ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty GUM-3:sayer ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass GUM-3:ConsciousBeing
                               ] ;
               owl:disjointWith GUM-3:Internal ;
               rdfs:comment "A process of communication with at least one participant playing the sayer role, and possibly an participant playing a reciever role (HM 1999: 129--130). The sayer is not necessarily an entity endowed with consciousness (HM 1999: 135)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Fearing
GUM-3:Fearing rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:ReactionAndEmotion ;
              owl:disjointWith GUM-3:Liking ;
              rdfs:comment "A mental reaction that is negative towards some object or state of affairs and which invokes fear." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Female
GUM-3:Female rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:Person ;
             owl:disjointWith GUM-3:Male ;
             rdfs:comment "A object that is to be considered female, for, e.g., pronominalization purposes." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Future
GUM-3:Future rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:TimeInterval ;
             owl:disjointWith GUM-3:OneOrTwoDTime ,
                              GUM-3:Past ,
                              GUM-3:Present ,
                              GUM-3:ProfilesAndStages ,
                              GUM-3:TemporalProfile ,
                              GUM-3:ThreeDTime ;
             rdfs:comment "A time interval taking place in the future." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GUMThing
GUM-3:GUMThing rdf:type owl:Class ;
               rdfs:comment "The most general experiential category that can be expressed through the resources of the lexicogrammar of a language. UMThing corresponds to 'phenomena' in Halliday and Mathiessen (1999: 48)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GeneralPossibility
GUM-3:GeneralPossibility rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:Possibility ;
                         rdfs:comment "A general possibility relationship is a modal modification of a process that indicates that the process may occur; it is typically realized using the modal `may'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GeneralizedLocating
GUM-3:GeneralizedLocating rdf:type owl:Class ;
                          rdfs:subClassOf GUM-3:Circumstantial ;
                          rdfs:comment "A concept for specifying the location of an entity in physical space, time, or in a more abstract space (Bateman, Rinaldi, and Henschel 1995, p. 33)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GeneralizedPossession
GUM-3:GeneralizedPossession rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:Relating ;
                            owl:disjointWith GUM-3:GeneralizedPossessionInverse ,
                                             GUM-3:Intensive ;
                            rdfs:comment "GeneralizedPossession logically has two roles: POSSESSOR (the domain) and POSSESSED (the range). The notion of generalized possession is often expressed as: {possessor} `has' {possessed}. In general, relations in this category can also be expressed with a possessive form, e.g. `John's book', `Henry's sister'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GeneralizedPossessionInverse
GUM-3:GeneralizedPossessionInverse rdf:type owl:Class ;
                                   rdfs:subClassOf GUM-3:Relating ;
                                   owl:disjointWith GUM-3:Intensive ;
                                   rdfs:comment "The inverse of the GeneralizedPossession relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GeneralizedRoleRelation
GUM-3:GeneralizedRoleRelation rdf:type owl:Class ;
                              rdfs:subClassOf GUM-3:GeneralizedPossession ;
                              owl:disjointWith GUM-3:NameOf ,
                                               GUM-3:Ownership ,
                                               GUM-3:PartWhole ;
                              rdfs:comment "This is the generalized perspective on an entity that `has some relationship' with another. When no more specific information concerning available grammatical realizations is given, subtypes ({role}) of this relationship can be used to generate language of the form:  ``{domain} has {range} as {role}'' or ``{domain}'s {role} is {range}''." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GreaterThan
GUM-3:GreaterThan rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:NumberFocusing ;
                  owl:disjointWith GUM-3:LessThan ;
                  rdfs:comment "A relative quantity ascription that specifies a range beginning at some lower bound." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#GreaterThanComparison
GUM-3:GreaterThanComparison rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:ScaledComparison ;
                            owl:disjointWith GUM-3:LessThanComparison ;
                            rdfs:comment "The scaled comparison that compares by stating that a quality holds more rather than less." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Hailing
GUM-3:Hailing rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Ambience ;
              owl:disjointWith GUM-3:Raining ,
                               GUM-3:Snowing ,
                               GUM-3:Sunning ,
                               GUM-3:Winding ;
              rdfs:comment "A process describing a hailing condition." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#IdeaProjection
GUM-3:IdeaProjection rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:Projection ;
                     owl:disjointWith GUM-3:LocutionProjection ;
                     rdfs:comment "A projection such that the configuration in the range refers to the meaning content of what someone said or thought (HM 1999: 108)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#IdeaQuoting
GUM-3:IdeaQuoting rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:IdeaProjection ,
                                  GUM-3:Quoting ;
                  owl:disjointWith GUM-3:IdeaReporting ,
                                   GUM-3:LocutionQuoting ;
                  rdfs:comment "The projecting of an idea by a Configuration such that the projected idea is equal to the other in terms of semantic status (HM 1999: 114). E.g., \"Harriet thought, 'Should I feed the cat'.\"" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#IdeaReporting
GUM-3:IdeaReporting rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:IdeaProjection ,
                                    GUM-3:Reporting ;
                    owl:disjointWith GUM-3:LocutionReporting ;
                    rdfs:comment "The projecting of one idea by another such that the projected idea is not equal to the other in terms of semantic status; they have different 'semantic weights'  (HM 1999: 114) E.g., \"Harriet wondered whether she should feed the cat\"." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Identity
GUM-3:Identity rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:Intensive ;
               owl:disjointWith GUM-3:Symbolization ;
               rdfs:comment "The type of relation between entities that states that they are in some sense identical or overlapping. Sentences typical of this type of relation are `X is Y', or `X is mine'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#InstantaneousInTime
GUM-3:InstantaneousInTime rdf:type owl:Class ;
                          rdfs:subClassOf GUM-3:TemporalProfile ;
                          rdfs:comment "A Configuration may be take time to unfold or be instantaneous  (HM 1999: 471). Instantaneous changes occur in achievements, or resultatives, when a culmination state occurs without a prior unfolding (cf. Dowty, Pustejovsky, Frawley, Bach)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Intensive
GUM-3:Intensive rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:Relating ;
                rdfs:comment "Intensive relations are those which ascribe a property to an object, or which identify or symbolize it." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Intention
GUM-3:Intention rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:Internal ;
                owl:disjointWith GUM-3:MentalActive ,
                                 GUM-3:MentalInactive ,
                                 GUM-3:Perception ,
                                 GUM-3:ReactionAndEmotion ;
                rdfs:comment """An Intention configuration has a mental process that captures the notion of actively pursuing a determinate aim.

---note:
Reaction (2.0) becomes Intention (3.0) to avoid confusion.""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Internal
GUM-3:Internal rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:SayingAndSensing ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty GUM-3:senser ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass GUM-3:ConsciousBeing
                               ] ;
               rdfs:comment """A communicative Configuration that projects ideas into existence (HM 1999: 136). At least one concious participant playing the senser role is required (HM 1999: 129--130). If this constraint is violated by an utterance, the utterance is grammatically metaphorical. E.g., ``I think I'll give it up.''
--------
There is also a role for the PHENOMENON of mental processing ().""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Know
GUM-3:Know rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:Cognition ;
           owl:disjointWith GUM-3:Think ;
           rdfs:comment "A mental process describing the involuntary state of knowing that something is the case." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LessThan
GUM-3:LessThan rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:NumberFocusing ;
               rdfs:comment "A relative quantity ascription with respect to a higher bound." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LessThanComparison
GUM-3:LessThanComparison rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:ScaledComparison ;
                         rdfs:comment "The scaled comparison that compares by stating that a quality holds less rather than more." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Liking
GUM-3:Liking rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:ReactionAndEmotion ;
             rdfs:comment "An involuntary favorable mental/emotional reaction to some entity or state of affairs, or a process that presupposes a favorable reaction, e.g. to `want' or `strive' to bring something about." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LocutionProjection
GUM-3:LocutionProjection rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:Projection ;
                         rdfs:comment "A projection such that the range configuration is what someone said (HM 1999: 108)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LocutionQuoting
GUM-3:LocutionQuoting rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:LocutionProjection ,
                                      GUM-3:Quoting ;
                      owl:disjointWith GUM-3:LocutionReporting ;
                      rdfs:comment "The projecting of speech by a Configuration such that the projected speech is  equal to the other in terms of semantic status (HM 1999: 114). E.g., \"Harriet said, 'Should I feed the cat'.\"" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LocutionReporting
GUM-3:LocutionReporting rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:LocutionProjection ,
                                        GUM-3:Reporting ;
                        rdfs:comment "The projecting of one locution by another such that the projected locution is not equal to the other in terms of semantic status; they have different 'semantic weights'  (HM 1999: 114) E.g., \"Harriet asked whether she should feed the cat\"." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LogicalPropertyAscription
GUM-3:LogicalPropertyAscription rdf:type owl:Class ;
                                rdfs:subClassOf GUM-3:PropertyAscription ;
                                owl:disjointWith GUM-3:MaterialPropertyAscription ,
                                                 GUM-3:ModalPropertyAscription ,
                                                 GUM-3:ProvenancePropertyAscription ,
                                                 GUM-3:ScaledComparison ,
                                                 GUM-3:SizePropertyAscription ,
                                                 GUM-3:UsePropertyAscription ;
                                rdfs:comment "?? The type of ascription of property that ascribes a logical parameter to an object (like true or false)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LogicalQuality
GUM-3:LogicalQuality rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:SimpleQuality ;
                     owl:disjointWith GUM-3:MaterialWorldQuality ,
                                      GUM-3:ModalQuality .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#LogicalUniqueness
GUM-3:LogicalUniqueness rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:LogicalQuality ;
                        rdfs:comment "" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Male
GUM-3:Male rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:Person ;
           rdfs:comment "A object that is to be considered male, for, e.g., pronominalization purposes." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MaterialClassQuality
GUM-3:MaterialClassQuality rdf:type owl:Class ;
                           rdfs:subClassOf GUM-3:ClassQuality ;
                           owl:disjointWith GUM-3:ProvenanceClassQuality ;
                           rdfs:comment "MaterialClassQuality describes the quality of being made of a particular material, e.g. wood, metal, etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MaterialPropertyAscription
GUM-3:MaterialPropertyAscription rdf:type owl:Class ;
                                 rdfs:subClassOf GUM-3:PropertyAscription ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty GUM-3:attribute ;
                                                   owl:allValuesFrom GUM-3:MaterialClassQuality
                                                 ] ;
                                 owl:disjointWith GUM-3:ModalPropertyAscription ,
                                                  GUM-3:ProvenancePropertyAscription ,
                                                  GUM-3:ScaledComparison ,
                                                  GUM-3:SizePropertyAscription ,
                                                  GUM-3:UsePropertyAscription ;
                                 rdfs:comment "The general ascription of a material world quality." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MaterialWorldQuality
GUM-3:MaterialWorldQuality rdf:type owl:Class ;
                           rdfs:subClassOf GUM-3:SimpleQuality ;
                           owl:disjointWith GUM-3:ModalQuality ;
                           rdfs:comment "Material qualities can be thought of as those qualities which are evident when the referent is looked at, weighed, measured, etc. Examples include: `heavy', `blue', `American', `readable', `efficient', `maintainable'. The referents of these qualities are things." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MentalActive
GUM-3:MentalActive rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:Internal ;
                   owl:disjointWith GUM-3:MentalInactive ,
                                    GUM-3:Perception ,
                                    GUM-3:ReactionAndEmotion ;
                   rdfs:comment "This is another specialization of actions concerned with mental processing. Examples of verbs which would fall into this category are: `convince', `please'. Also the verb `will', in the context: ``I will that something be the case''." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MentalInactive
GUM-3:MentalInactive rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:Internal ;
                     owl:disjointWith GUM-3:Perception ,
                                      GUM-3:ReactionAndEmotion ;
                     rdfs:comment "Concepts in this category describe passive, inactive mental processing. There are 3 subtypes of this category: Perception (e.g. `see`, `hear`, `taste`, `smell`, `feel`), Cognition (e.g. `think`, `believe`, `know`, `understand`, `realize`), and Reaction/Emotion/Affection (e.g. `love`, `hate`, `want`, `wish`, `fear`, `desire`.)  MentalInactives do not normally take the progressive form. Recall that materialactions do take the progressive form.Passivization is rare for most of these, except in the case where the phenomenon is a noun phrase, e.g. ``Henry likes Mary.'' ``Mary is liked by Henry.'' but not ``Henry likes to go to the races.'' ``*To go to the races is liked by Henry.''  These also often form `reversal pairs'. One of the mental actions in the pair is active, the other is inactive (or inactive), e.g.``I *like* bananas.'' vs.  ``Bananas *please* me.'' Other pairs are {fear, frighten}, {wonder, amaze}, {desire,  attract}. Compare this to actions where reversal is only possible using passive voice." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MessageOriented
GUM-3:MessageOriented rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:ProperVerbal ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty GUM-3:saying ;
                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                      ] ;
                      owl:disjointWith GUM-3:NonMessageOriented ;
                      rdfs:comment "For MessageOriented verbal processes the message is an obligatory role, although the message may not always be expressed." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MessageTransfer
GUM-3:MessageTransfer rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:MessageOriented ,
                                      GUM-3:NonAddresseeOriented ;
                      rdfs:comment "MessageTransfer verbal configurations are usually realized by means of verbs having the message as a direct complement but the addressee as an indirect complement." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ModalPropertyAscription
GUM-3:ModalPropertyAscription rdf:type owl:Class ;
                              rdfs:subClassOf GUM-3:PropertyAscription ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty GUM-3:attribute ;
                                                owl:allValuesFrom GUM-3:ModalQuality
                                              ] ;
                              owl:disjointWith GUM-3:ProvenancePropertyAscription ,
                                               GUM-3:ScaledComparison ,
                                               GUM-3:SizePropertyAscription ,
                                               GUM-3:UsePropertyAscription ;
                              rdfs:comment "The ascription of a modal quality, typically to a process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ModalQuality
GUM-3:ModalQuality rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:SimpleQuality ;
                   rdfs:comment "Qualities of being able to do something, wanting to do something, having to do something, and so forth." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#MultiConfiguration
GUM-3:MultiConfiguration rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:GUMThing ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty GUM-3:alphaParticipantInMultiConfiguration ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass GUM-3:GUMThing
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty GUM-3:betaParticipantInMultiConfiguration ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass GUM-3:GUMThing
                                         ] ;
                         rdfs:comment "Formerly labelled 'sequence' (GUM 2.0), this is a series of related Configurations. Various sorts of Sequences are differentiated by the type of relation they enter into. Every MultiConfiguration consists of two ordered parts, a first and a second participant, which is a Configuration or a MultiConfiguration. Furthermore, MultiConfigurations are either Equative or NonEquative (HM 1999: 50)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Name
GUM-3:Name rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:Word ;
           rdfs:comment "An accepted but possibly arbitrary label for some entity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NameEvent
GUM-3:NameEvent rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:DispositiveMaterialAction ,
                                GUM-3:External ;
                owl:disjointWith GUM-3:ProperVerbal ;
                rdfs:comment "The process of giving something a name. It does not intrinsically require an addressee (non-addressee-oriented)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NameOf
GUM-3:NameOf rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:GeneralizedPossession ;
             owl:disjointWith GUM-3:Ownership ,
                              GUM-3:PartWhole ;
             rdfs:comment "The relation that holds betwen a name and its bearer." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NameRelation
GUM-3:NameRelation rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:Symbolization ;
                   owl:disjointWith GUM-3:RolePlaying ,
                                    GUM-3:Signification ;
                   rdfs:comment "The relation that holds between a name's bearer and that name." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NamedObject
GUM-3:NamedObject rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:SimpleThing ;
                  rdfs:comment "Objects which typically have names." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NaturalNumber
GUM-3:NaturalNumber rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:Abstraction ;
                    owl:disjointWith GUM-3:RoleOrOffice ,
                                     GUM-3:UMSet ,
                                     GUM-3:Word ;
                    rdfs:comment "A type of abstraction referring to numerical value." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Necessity
GUM-3:Necessity rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:NonVolitional ;
                owl:disjointWith GUM-3:Possibility ;
                rdfs:comment """
	  A modal qualification of the process, with respect to the necessity of performing that process or having a state hold; typically realized by modals such as `must', `should' etc., or as nominalizations such as `necessary' or verbal forms such as `required'.""" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonAddresseeOriented
GUM-3:NonAddresseeOriented rdf:type owl:Class ;
                           rdfs:subClassOf GUM-3:ProperVerbal ;
                           rdfs:comment "This concepts describes verbal processes that do not intrinsically require an addressee. If the addressee occurs it must always be indirect." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonAddressing
GUM-3:NonAddressing rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:BehavioralVerbal ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty GUM-3:addressee ;
                                      owl:cardinality "0"^^xsd:nonNegativeInteger
                                    ] ;
                    rdfs:comment "This BehavioralVerbal configuration has no direct adressee." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonAffectingAction
GUM-3:NonAffectingAction rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:DoingAndHappening ;
                         rdfs:comment "NonAffectingActions have no `actee', or the `actee' is not created or affected by the action. They are often (though not necessarily) intransitive. In the case they are transitive, the object is not affected or created by the action. Instead it specifies a range of the action. For example, ``I play the piano/ tennis.'' This specifies that I am capable of a typical kind of playing.  All verbs of movement are examples of NonAffectingActions, e.g. `climb', `walk', `fly', `fall', `run'. Skills, such as `read (book)', `listen (music)', `speak (French), etc. are included in this category. In addition, the verbs `have' as in `have lunch', `take' as in `take a shower', `do' as in `do a dance', and `make' are in this category." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonAffectingDoing
GUM-3:NonAffectingDoing rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:NonAffectingAction ;
                        owl:disjointWith GUM-3:NonAffectingHappening ;
                        rdfs:comment "An action where the \"actor\" is one who intentionally performs the action. Verbs of movement, like \"climb\", \"walk\", etc., are examples of such actions." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonAffectingHappening
GUM-3:NonAffectingHappening rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:NonAffectingAction ;
                            rdfs:comment "An action where something is happening. Also where the \"actor\" is not volitionally performing the action." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonConditional
GUM-3:NonConditional rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:ModalQuality ;
                     owl:disjointWith GUM-3:NonVolitional ,
                                      GUM-3:Volitional ;
                     rdfs:comment "A type of modal quality. Modal qualities that are not conditional are expressed with modalities such as: \"will\", \"must\", \"can\", etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonConsciousThing
GUM-3:NonConsciousThing rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:SimpleThing ;
                        rdfs:comment "Some entities are just not treated by the language to be conscious. They go here." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonDecomposableObject
GUM-3:NonDecomposableObject rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:SimpleThing ;
                            rdfs:comment "An object that is being regarded as not possessing significant parts, or which is not to be considered decomposable for present purposes." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonMessageOriented
GUM-3:NonMessageOriented rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:ProperVerbal ;
                         rdfs:comment "A process of a NonMessageOriented configuration does not intrinsically require a message. If a message occurs it must always be indirect." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonScalableQuality
GUM-3:NonScalableQuality rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:MaterialWorldQuality ;
                         owl:disjointWith GUM-3:ScalableQuality ;
                         rdfs:comment "A NonScaleableQuality is either possessed by an object or it is not. `Empty' is a nonscaleable quality. A quality is scaleable if an object may possess it to varying degrees. For example, `heavy' is a scaleable quality. We can describe objects as being `very heavy', or `more' or `less' heavy than other objects." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NonVolitional
GUM-3:NonVolitional rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:ModalQuality ;
                    owl:disjointWith GUM-3:Volitional ;
                    rdfs:comment "A nonvolitional process is one where the actor did not take, or is not expressed as taking, direct responsibility for the process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#NumberFocusing
GUM-3:NumberFocusing rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:QuantityAscription ;
                     owl:disjointWith GUM-3:Quantity ;
                     rdfs:comment "The relation of being more specific about a quantity that is being ascribed. This contrasts with quantity, which provides no additional information concerning the quantity apart from its value." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#OneOrTwoDLocation
GUM-3:OneOrTwoDLocation rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:SpaceInterval ;
                        owl:disjointWith GUM-3:ThreeDLocation ;
                        rdfs:comment "A spatial object that is either a line or a plane." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#OneOrTwoDTime
GUM-3:OneOrTwoDTime rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:TimeInterval ;
                    owl:disjointWith GUM-3:Past ,
                                     GUM-3:Present ,
                                     GUM-3:ProfilesAndStages ,
                                     GUM-3:TemporalProfile ,
                                     GUM-3:ThreeDTime ;
                    rdfs:comment "A temporal object that is a time interval or smaller scale succession of time intervals, e.g. a day (in opposition to a year). This is clearly a matter of the perspective that is being drawn in particular cases." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#OrderedObject
GUM-3:OrderedObject rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:DecomposableObject ;
                    rdfs:comment "A type of decomposable object whose parts have an intrinsic ordering of their own; for example, the elements of a list, the carriages of a train, etc. (Used to be \"Element\".)" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#OrderedSet
GUM-3:OrderedSet rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:OrderedObject ,
                                 GUM-3:UMSet ;
                 owl:disjointWith GUM-3:SpaceInterval ,
                                  GUM-3:TimeInterval ;
                 rdfs:comment "A set whose elements are ordered." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#OwnedBy
GUM-3:OwnedBy rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:GeneralizedPossessionInverse ;
              owl:disjointWith GUM-3:PartOf ;
              rdfs:comment "The inverse of the Ownership relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Ownership
GUM-3:Ownership rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:GeneralizedPossession ;
                owl:disjointWith GUM-3:PartWhole ;
                rdfs:comment "This is a relation between the owner of an object and the object. It has the same roles as GeneralizedPossession, but the possessor role could be valuerestricted to ACTIVEENTITY. Ownership may be expressed as ``{possessor} `own' {possessed>}' or ``{possessed} `belongs to' {possessor}''." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Part
GUM-3:Part rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:PartWhole ;
           rdfs:comment "One of the participants in a PartWhole relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#PartOf
GUM-3:PartOf rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:GeneralizedPossessionInverse ;
             rdfs:comment "The inverse of the Part relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#PartWhole
GUM-3:PartWhole rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:GeneralizedPossession ;
                rdfs:comment "This is a relation between an entity and its parts. It logically has two roles: WHOLE (the domain) and PART (the range). How this relation is expressed in the language seems to depend on the type of object that fills the WHOLE role. At the most general level, this relation can be expressed as: ``{Part} `be an element of' {whole} or ``{part} `be a component of' {whole}'', or \"{whole} has {part}\". (The latter is inherited from the superconcept GeneralizedPossession.)" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Past
GUM-3:Past rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:TimeInterval ;
           owl:disjointWith GUM-3:Present ,
                            GUM-3:ProfilesAndStages ,
                            GUM-3:TemporalProfile ,
                            GUM-3:ThreeDTime ;
           rdfs:comment "A time interval taking place in the past." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Perception
GUM-3:Perception rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:Internal ;
                 owl:disjointWith GUM-3:ReactionAndEmotion ;
                 rdfs:comment "An involuntary mental process of perceiving a phenomenon." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Person
GUM-3:Person rdf:type owl:Class ;
             rdfs:subClassOf GUM-3:ConsciousBeing ;
             rdfs:comment "A type of conscious being pronominalizeable by `she', `he', etc. rather than by `it'." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#PolarQuality
GUM-3:PolarQuality rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:MaterialWorldQuality ;
                   owl:disjointWith GUM-3:TaxonomicQuality ;
                   rdfs:comment "A quality is polar if it has a corresponding quality describing its opposite or the absence of this quality entirely. A polar quality is not part of a larger taxonomy. E.g. `heavy'/`light', `dead'/`alive'. All qualities which are not polar are taxonomic, i.e. the possible values can be listed. For example, the quality of being mammal is part of some taxonomy." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Possibility
GUM-3:Possibility rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:NonVolitional ;
                  rdfs:comment "A general modal quality." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Present
GUM-3:Present rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:TimeInterval ;
              owl:disjointWith GUM-3:ProfilesAndStages ,
                               GUM-3:TemporalProfile ,
                               GUM-3:ThreeDTime ;
              rdfs:comment "A time interval taking place at present." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Process
GUM-3:Process rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Element ;
              owl:disjointWith GUM-3:SimpleQuality ,
                               GUM-3:SimpleThing ;
              rdfs:comment "A Process is the linguistic construal of `goings-on' or events. Processes are similar to Configurations, but factor out Participants, Circumstances, and other elements. As such, entities classified under Process can be expressed as verbs and are frequently the main verb in a clause." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ProfilesAndStages
GUM-3:ProfilesAndStages rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:TimeInterval ;
                        owl:disjointWith GUM-3:ThreeDTime ;
                        rdfs:comment "Time interval may also have a particular 'shape' of unfolding according to their boundness and duration  (HM 1999: 471)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Projection
GUM-3:Projection rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:MultiConfiguration ;
                 rdfs:comment "A semiotic projection such that a configuration of saying or thinking (the domain) 'projects' another configuration (the range) onto a different plane of reality, that is, the `content plane', as in the reporting of what someone said or thought. The second is then dependent upon the first (HM 1999: 108, 111)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ProperVerbal
GUM-3:ProperVerbal rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:External ;
                   rdfs:comment "Unlike BehavioralVerbal this concept describes a configuration with a regular verbal process. We distinguish between addressee-oriented (e.g. \"tell\") and non-addressee-oriented (e.g. \"say\"), message-oriented (e.g. \"prove\") and non-message-oriented (e.g. \"inform\")." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#PropertyAscription
GUM-3:PropertyAscription rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:Ascription ;
                         owl:disjointWith GUM-3:QuantityAscription ;
                         rdfs:comment "The relation describing membership in the set of entities having a particular property. This is expressed by a property that can be used as a set descriptor. For example, ``The students are intelligent.'' i.e. they belong to the class of intelligent ones. Note that 'intelligent' is a quality. We need many specializations of property ascription corresponding to different types of qualities." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#PropertyOf
GUM-3:PropertyOf rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:AscriptionInverse ;
                 rdfs:comment "The inverse of the PropertyAscription relation." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ProvenanceClassQuality
GUM-3:ProvenanceClassQuality rdf:type owl:Class ;
                             rdfs:subClassOf GUM-3:ClassQuality ;
                             rdfs:comment "Information that constrains reference by place, institution, social group or other social category of origin." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ProvenancePropertyAscription
GUM-3:ProvenancePropertyAscription rdf:type owl:Class ;
                                   rdfs:subClassOf GUM-3:PropertyAscription ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty GUM-3:attribute ;
                                                     owl:allValuesFrom GUM-3:ProvenanceClassQuality
                                                   ] ;
                                   owl:disjointWith GUM-3:ScaledComparison ,
                                                    GUM-3:SizePropertyAscription ,
                                                    GUM-3:UsePropertyAscription ;
                                   rdfs:comment "The relation of ascribing a provenance class quality to an entity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Quantity
GUM-3:Quantity rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:QuantityAscription ;
               rdfs:comment "The relation of ascribing a quantity to some entity. This contrasts with NumberFocusing, which provides information additional to the value of the quantity being ascribed, e.g. a range bounded by some value." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#QuantityAscription
GUM-3:QuantityAscription rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:Ascription ;
                         rdfs:comment "The relation of ascribing a quantity to an entity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Quoting
GUM-3:Quoting rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Projection ;
              owl:disjointWith GUM-3:Reporting ;
              rdfs:comment "A Projection such the two configurations have equal status. The two have equal status as independent configurations; the projected configuration is thus projected as if it was still part of the same first-order reality (HM 1999: 111)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Raining
GUM-3:Raining rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Ambience ;
              owl:disjointWith GUM-3:Snowing ,
                               GUM-3:Sunning ,
                               GUM-3:Winding ;
              rdfs:comment "A process describing a raining condition." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ReactionAndEmotion
GUM-3:ReactionAndEmotion rdf:type owl:Class ;
                         rdfs:subClassOf GUM-3:Internal ;
                         rdfs:comment "An inactive mental process that captures an uncontrolled emotional response to something or some state of affairs in terms of its appeal. Examples would be FEARING and DISLIKING on the negative side, and LIKING on the positive side." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Relating
GUM-3:Relating rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:BeingAndHaving ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty GUM-3:attribute ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass GUM-3:Element
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty GUM-3:domain ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass GUM-3:Element
                               ] ;
               rdfs:comment "A configuration indicating a relation holding between two entities. A relating must contain at least a domain and an attribute." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Reporting
GUM-3:Reporting rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:Projection ;
                rdfs:comment "A projection such the two configurations have unequal status. The latter is on a second-order plane of reality (HM 1999: 111)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#RoleOrOffice
GUM-3:RoleOrOffice rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:Abstraction ;
                   owl:disjointWith GUM-3:UMSet ,
                                    GUM-3:Word ;
                   rdfs:comment "A type of abstraction referring to a role or position within an institution." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#RolePlaying
GUM-3:RolePlaying rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Symbolization ;
                  owl:disjointWith GUM-3:Signification ;
                  rdfs:comment "A circumstantial relationship that expresses a restriction in which a facet of one of the participants in a process is relevant for the actualization of the process. The participation of a participant which is specified in, and has a definite participant function (such as actor, goal, senser, and phenomenon to the process) is restricted to a particular role, part, or function within the particular participant function being performed. It is frequently realized in English by a prepositional phrase with the preposition `as'; For example: ``As a president, he was terrible, although as a golfer he was not too bad.''" .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SayingAndSensing
GUM-3:SayingAndSensing rdf:type owl:Class ;
                       rdfs:subClassOf GUM-3:Configuration ;
                       rdfs:comment "Configurations that can project symbolically. Projective sequences, ie Projections, construe SayingANDSensing on two levels: the level of SayingANDSensing cum Configuration and the level of content of SayingANDSensing (HM 1999: 128--129)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ScalableQuality
GUM-3:ScalableQuality rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:MaterialWorldQuality ;
                      owl:disjointWith GUM-3:TaxonomicQuality ;
                      rdfs:comment "A quality is scaleable if an object may possess it to varying degrees. For example, `heavy' is a scaleable quality. We can describe objects as being `very heavy', or `more' or `less' heavy than other objects. A nonscaleable quality is either possessed by an object or it is not. `Empty' is a nonscaleable quality." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ScaledComparison
GUM-3:ScaledComparison rdf:type owl:Class ;
                       rdfs:subClassOf GUM-3:PropertyAscription ;
                       owl:disjointWith GUM-3:SizePropertyAscription ,
                                        GUM-3:UsePropertyAscription ;
                       rdfs:comment "A relationship of comparison of an object with respect to its carrying a specified property to a greater or lesser degree." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SenseANDMeasureQuality
GUM-3:SenseANDMeasureQuality rdf:type owl:Class ;
                             rdfs:subClassOf GUM-3:PolarQuality ,
                                             GUM-3:ScalableQuality ,
                                             GUM-3:StativeQuality ;
                             owl:disjointWith GUM-3:StatusQuality ;
                             rdfs:comment "These are qualities that are sensed or measured by conscious beings. For example, this category would include qualities of age (young, old), of weight (light, heavy), price (expensive, cheap), etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Signification
GUM-3:Signification rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:Symbolization ;
                    rdfs:comment "Relations concerned with Signification are linguistically realized by verbs like \"represent\", \"mean\", \"express\", e.g., \"green means go\"." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SimpleQuality
GUM-3:SimpleQuality rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:Element ;
                    owl:disjointWith GUM-3:SimpleThing ;
                    rdfs:comment "Qualities are properties of SimpleThings and Processes. They participate in property ascription relations. Roughly speaking, qualities include anything that can be expressed as an English adjective." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SimpleThing
GUM-3:SimpleThing rdf:type owl:Class ;
                  rdfs:subClassOf GUM-3:Element ;
                  rdfs:comment "An entity which may participate in a configuration." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Size
GUM-3:Size rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:SenseANDMeasureQuality ;
           rdfs:comment "A property of size." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SizePropertyAscription
GUM-3:SizePropertyAscription rdf:type owl:Class ;
                             rdfs:subClassOf GUM-3:PropertyAscription ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty GUM-3:attribute ;
                                               owl:allValuesFrom GUM-3:Size
                                             ] ;
                             owl:disjointWith GUM-3:UsePropertyAscription ;
                             rdfs:comment "The relationship of ascribing a size to an entity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Snowing
GUM-3:Snowing rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Ambience ;
              owl:disjointWith GUM-3:Sunning ,
                               GUM-3:Winding ;
              rdfs:comment "A process describing a snowing condition." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Space
GUM-3:Space rdf:type owl:Class ;
            rdfs:subClassOf GUM-3:SpatialObject ,
                            GUM-3:Substance ;
            owl:disjointWith GUM-3:SpaceInterval ,
                             GUM-3:SpacePoint ,
                             GUM-3:Time ;
            rdfs:comment "Space as an undecomposable mass." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SpaceInterval
GUM-3:SpaceInterval rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:OrderedObject ,
                                    GUM-3:SpatialObject ;
                    owl:disjointWith GUM-3:SpacePoint ,
                                     GUM-3:TimeInterval ;
                    rdfs:comment "Space as a decomposible set of points, intervals, or volumes." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SpacePoint
GUM-3:SpacePoint rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:NonDecomposableObject ,
                                 GUM-3:SpatialObject ;
                 owl:disjointWith GUM-3:Substance ,
                                  GUM-3:TimePoint ;
                 rdfs:comment "Space as a point." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SpatialObject
GUM-3:SpatialObject rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:SpatialTemporal ;
                    owl:disjointWith GUM-3:TemporalObject ;
                    rdfs:comment "The general concept of spatial objects, including all points, paths, volumes, undivided wholes, etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SpatialTemporal
GUM-3:SpatialTemporal rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:NonConsciousThing ;
                      rdfs:comment "The generalized timespace object, under which all time and space objects lie." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SpecificMatter
GUM-3:SpecificMatter rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:SubjectMatter ;
                     rdfs:comment "Distinguish between explicit focus on referent, and more general, diffuse reference (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#StativeQuality
GUM-3:StativeQuality rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:MaterialWorldQuality ;
                     rdfs:comment "Stative qualities hold regardless of any particular process. Dynamic qualities can be expressed using the present progressive tense, i.e. they can take the form: ``X is being *quality*.'' ``John is being clever/skillful/creative/enthusiastic.'' Stative qualities cannot. ``*John is being dead/German/tall.'' These can take the simple present only." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#StatusQuality
GUM-3:StatusQuality rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:NonScalableQuality ,
                                    GUM-3:PolarQuality ,
                                    GUM-3:StativeQuality ;
                    rdfs:comment "StatusQuality is a quality of an object, independent of the observer. For example, specializations of this category could be the quality LIFESTATUS which would be further broken down into the classes DEAD and ALIVE." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Striving
GUM-3:Striving rdf:type owl:Class ;
               rdfs:subClassOf GUM-3:Liking ;
               owl:disjointWith GUM-3:Wanting ;
               rdfs:comment "A type of mental reaction that attempts to bring about some state of affairs or event." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#SubjectMatter
GUM-3:SubjectMatter rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:Circumstance ;
                    rdfs:comment "Expressed as: be about, as in: \"This document is about the entity hierarchy.'' (from MUM 1994)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Substance
GUM-3:Substance rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:NonConsciousThing ,
                                GUM-3:NonDecomposableObject ;
                owl:disjointWith GUM-3:TimePoint ;
                rdfs:comment "E.g., water, grass, flour, butter. The bounded region for substances is not in the domain of physical space, since they are in principle indefinitely expandable in space. Rather, their bounded region is in the domain of some quality spectrum (taste, color, texture, solidity, etc.)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Sunning
GUM-3:Sunning rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Ambience ;
              owl:disjointWith GUM-3:Winding ;
              rdfs:comment "A process describing a sunning condition." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Symbolization
GUM-3:Symbolization rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:Intensive ;
                    rdfs:comment "This category contains relations that hold between entities and other entities they `symbolize'. Concepts in this class logically have two roles: SYMBOL (the domain) and SYMBOLIZED (the range). One relation in this category is the relation between an object and a name which identifies that object." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TaxonomicQuality
GUM-3:TaxonomicQuality rdf:type owl:Class ;
                       rdfs:subClassOf GUM-3:MaterialWorldQuality ;
                       rdfs:comment "All qualities which are not polar are taxonomic, i.e. the possible values can be listed. For example, the quality of being mammal is part of some taxonomy." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TemporalObject
GUM-3:TemporalObject rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:SpatialTemporal ;
                     rdfs:comment "The general concept of temporal objects, including all points, paths, volumes, undivided wholes, etc." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TemporalProfile
GUM-3:TemporalProfile rdf:type owl:Class ;
                      rdfs:subClassOf GUM-3:ProfilesAndStages ;
                      owl:disjointWith GUM-3:ThreeDTime ;
                      rdfs:comment "A Configuration necessarily has a temporal profile that characterizes how it plays out in time  (HM 1999: 271)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TemporallyBounded
GUM-3:TemporallyBounded rdf:type owl:Class ;
                        rdfs:subClassOf GUM-3:TemporalProfile ;
                        owl:disjointWith GUM-3:TemporallyUnbounded ;
                        rdfs:comment "A Configuration may be bounded in time or unbounded with respect to its temporal profile  (HM 1999: 471). Resultatives (Dowty, Frawley) are bounded since they have an endpoint at which time they have been achieved or accomplished (Vendler). " .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TemporallyUnbounded
GUM-3:TemporallyUnbounded rdf:type owl:Class ;
                          rdfs:subClassOf GUM-3:TemporalProfile ;
                          rdfs:comment "A Configuration may be bounded in time or unbounded with respect to its temporal profile  (HM 1999: 471). Inchoatives (Dowty, Frawley) are unbounded since they have no endpoint at which time they have been achieved or accomplished (Vendler) and just continue." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Think
GUM-3:Think rdf:type owl:Class ;
            rdfs:subClassOf GUM-3:Cognition ;
            rdfs:comment "The mental process of thinking." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ThreeDLocation
GUM-3:ThreeDLocation rdf:type owl:Class ;
                     rdfs:subClassOf GUM-3:SpaceInterval ;
                     rdfs:comment "A three dimensional space." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ThreeDTime
GUM-3:ThreeDTime rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:TimeInterval ;
                 rdfs:comment "A portion of time that is being viewed as of sufficiently large scale to need expression as if it were a volume within which thing occured (e.g. in 1966), rather than a plane on which things occured (e.g. on that day)." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Time
GUM-3:Time rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:Substance ,
                           GUM-3:TemporalObject ;
           owl:disjointWith GUM-3:TimeInterval ,
                            GUM-3:TimePoint ;
           rdfs:comment "Time as a general undecomposable substance." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TimeInterval
GUM-3:TimeInterval rdf:type owl:Class ;
                   rdfs:subClassOf GUM-3:OrderedObject ,
                                   GUM-3:TemporalObject ;
                   owl:disjointWith GUM-3:TimePoint ;
                   rdfs:comment "A time interval." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#TimePoint
GUM-3:TimePoint rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:NonDecomposableObject ,
                                GUM-3:TemporalObject ;
                rdfs:comment "A time point." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#UMSet
GUM-3:UMSet rdf:type owl:Class ;
            rdfs:subClassOf GUM-3:Abstraction ,
                            GUM-3:DecomposableObject ;
            owl:disjointWith GUM-3:Word ;
            rdfs:comment "An abstract assemblage of elements." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#UsePropertyAscription
GUM-3:UsePropertyAscription rdf:type owl:Class ;
                            rdfs:subClassOf GUM-3:PropertyAscription ;
                            rdfs:comment "The relationship of ascribing a use to an entity." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Volitional
GUM-3:Volitional rdf:type owl:Class ;
                 rdfs:subClassOf GUM-3:ModalQuality ;
                 rdfs:comment "A modal quality concerned with the actor's active decision or volition in the performance of a process." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Wanting
GUM-3:Wanting rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Liking ;
              rdfs:comment "A type of mental reaction that wants to bring about some state of affairs or event." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Winding
GUM-3:Winding rdf:type owl:Class ;
              rdfs:subClassOf GUM-3:Ambience ;
              rdfs:comment "A process describing a winding condition." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#Word
GUM-3:Word rdf:type owl:Class ;
           rdfs:subClassOf GUM-3:Abstraction ;
           rdfs:comment "A type of abstraction referring to numerical value." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ZeroDLocation
GUM-3:ZeroDLocation rdf:type owl:Class ;
                    rdfs:subClassOf GUM-3:SpacePoint ;
                    rdfs:comment "A point in space." .


###  http://www.ontospace.uni-bremen.de/ontology/stable/GUM-3.owl#ZeroDTime
GUM-3:ZeroDTime rdf:type owl:Class ;
                rdfs:subClassOf GUM-3:TimePoint ;
                rdfs:comment "A point in time." .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class ;
          rdfs:comment "" .


